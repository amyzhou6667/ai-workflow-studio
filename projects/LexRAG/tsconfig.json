{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "typeRoots": ["../AI-StoryBoard-Studio/node_modules/@types"],
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react",
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ]
}
